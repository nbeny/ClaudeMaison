# Realtime — variables d'environnement de dev.
# Copier en .env (gitignored) et adapter.

NODE_ENV=development
HTTP_PORT=3100
HTTP_HOST=0.0.0.0
LOG_LEVEL=info

# Clé HS256 partagée avec edge-api. À échanger contre la même valeur en dev
# local. En prod, ce sera la clé publique d'une paire EdDSA (Vault).
JWT_SIGNING_KEY=dev-only-secret-must-be-at-least-32-chars-long
JWT_ISSUER=claudemaison-edge-api
JWT_AUDIENCE=claudemaison-clients

# NATS JetStream — démarrer le profil ai du compose (`docker compose --profile ai up`).
NATS_URL=nats://localhost:4222
NATS_STREAM=events

# Activer OTel : décommenter quand on lance le profil `obs` du compose.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=realtime
