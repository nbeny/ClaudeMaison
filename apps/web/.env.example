# Realm seedé par infrastructure/docker/keycloak/realm-claudemaison-dev.json.
# Le seul client OIDC livré par défaut est `edge-api`. Pour que le frontend
# Next.js puisse faire un Authorization Code Flow direct, il faut ajouter
# manuellement un client `claudemaison-web` (public, PKCE) dans Keycloak —
# sinon utiliser le grant via edge-api côté server-actions / route handlers.
KEYCLOAK_ISSUER=http://localhost:8080/realms/claudemaison-dev
KEYCLOAK_CLIENT_ID=claudemaison-web
KEYCLOAK_CLIENT_SECRET=replace-me
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-openssl-rand-hex-32
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3000/graphql
NEXT_PUBLIC_REALTIME_URL=http://localhost:3100
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
