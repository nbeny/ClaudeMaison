# ai-core — variables d'environnement de dev.
# Copier en .env (gitignored).

NODE_ENV=development
HTTP_PORT=4000
HTTP_HOST=0.0.0.0
GRPC_PORT=5002
LOG_LEVEL=info

# NATS — démarrer le profil `ai` du compose : `docker compose --profile ai up`.
NATS_URL=nats://localhost:4222
NATS_STREAM=events

# Même Postgres que edge-api (différents schémas).
DATABASE_URL=postgresql://claudemaison:claudemaison@localhost:5432/claudemaison

# Qdrant — profil `ai` du compose.
QDRANT_URL=http://localhost:6333

# Inference router — en dev sans GPU, pointe vers Ollama ou un mock OpenAI-compat.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dev-only
LLM_DEFAULT_MODEL=mistral-large-instruct

# Activer OTel : décommenter avec le profil `obs` du compose.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-core
