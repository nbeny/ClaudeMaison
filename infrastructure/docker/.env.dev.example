# Compose-level env-vars consumed by infrastructure/docker/docker-compose.dev.yml.
# Copier en `.env.dev` (non commité) et remplir les valeurs sensibles. Les
# defaults inline du compose suffisent au reste.

# Compte Mistral (souverain EU) — utilisé comme fallback par inference-router
# quand llama-cpp local est down ou en surcharge. Laisse vide si tu n'as pas
# de compte : inference-router servira alors uniquement le backend local.
MISTRAL_API_KEY=

# Surcharge éventuelle de la table de routage backend. Format documenté dans
# ADR-0013. Laisser vide pour utiliser le default `llama-cpp prio 0, Mistral
# prio 1` du compose.
MODEL_BACKENDS=

# Secrets partagés edge-api ↔ realtime. Les defaults inline du compose
# (32 caractères) suffisent au dev local ; surcharger ici en CI/staging.
# `openssl rand -hex 32` pour les générer.
JWT_SIGNING_KEY=
INTERNAL_SHARED_SECRET=

# Override du modèle par défaut côté ai-core. Doit matcher un nom déclaré
# dans MODEL_BACKENDS (Phase 1 : `mistral-7b-instruct-q4` ou `mistral`).
LLM_DEFAULT_MODEL=
